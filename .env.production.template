# ============================================================
# Digistay production env — paste vào /opt/digistay/.env.production
# ============================================================
# MẪU — chỉ chứa chỗ trống. Giá trị thật chỉ nằm trên VPS, trong
# /opt/digistay/.env và /opt/digistay/.env.production — KHÔNG BAO GIỜ commit.
# Tạo secret mới:  openssl rand -hex 32
# ============================================================

# ----- Postgres (dùng trong docker-compose) -----
POSTGRES_USER=digistay
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=digistay

# ----- App database (internal docker network) -----
# User/pass phải khớp POSTGRES_USER / POSTGRES_PASSWORD ở trên
DATABASE_URL=postgresql://digistay:CHANGE_ME@postgres:5432/digistay?schema=public

# ----- NextAuth -----
NEXTAUTH_URL=https://digistay.vn
NEXTAUTH_SECRET=CHANGE_ME

# ----- Tên miền riêng của khách sạn (docs/RUNBOOK.md, "SSL tên miền con qua Cloudflare") -----
# Tên DNS only mà CNAME (và bản ghi A) của khách sạn trỏ tới khi *.digistay.vn đi qua proxy
# Cloudflare. Chỉ đặt sau khi bản ghi này đã có trên Cloudflare (mây xám).
# CUSTOM_DOMAIN_CNAME_TARGET=domains.digistay.vn

# ----- Khoá mã hoá dữ liệu (docs/RUNBOOK.md, "Khoá mã hoá dữ liệu") -----
# BẮT BUỘC. Mã hoá secret lưu trong DB (2FA, khoá thanh toán...).
# Tạo: echo "1:$(openssl rand -base64 32)". Đúng MỘT dòng; cất bản sao ngoài VPS.
# Thiếu hoặc sai định dạng thì /api/health báo lỗi và deploy quay về bản cũ.
DATA_ENCRYPTION_KEYS=

# ----- Job định kỳ (docs/RUNBOOK.md, "Đối soát PayOS định kỳ") -----
# Tạo: openssl rand -hex 32
CRON_SECRET=
# Email nhận cảnh báo vận hành, cách nhau bằng dấu phẩy (để trống: mọi user SUPER_ADMIN)
ALERT_EMAILS=

# ----- Google OAuth -----
# Console: https://console.cloud.google.com/apis/credentials
# Tạo OAuth 2.0 Client ID (type: Web application)
# Authorized redirect URIs phải có:
#   https://digistay.vn/api/auth/callback/google
GOOGLE_CLIENT_ID=PASTE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=PASTE_GOOGLE_CLIENT_SECRET

# ----- PayOS của Digistay (tiền khách sạn mua gói, src/lib/billing) -----
# Một kênh thanh toán RIÊNG trong PayOS (không dùng lại kênh của app khác:
# đăng ký webhook Digistay sẽ thay webhook của kênh đó). RUNBOOK: "Bán gói".
DIGISTAY_PAYOS_CLIENT_ID=PASTE_DIGISTAY_PAYOS_CLIENT_ID
DIGISTAY_PAYOS_API_KEY=PASTE_DIGISTAY_PAYOS_API_KEY
DIGISTAY_PAYOS_CHECKSUM_KEY=PASTE_DIGISTAY_PAYOS_CHECKSUM_KEY

# ----- Hoá đơn điện tử của Digistay (hoá đơn khi khách sạn mua gói, src/lib/billing/einvoice.ts) -----
# Tài khoản Mắt Bão đứng tên MST của Digistay. Để PASTE_…: không xuất hoá đơn gói.
# DEMO khi thử (không tạo hoá đơn thật); PRODUCTION khi bán thật. RUNBOOK: "Hoá đơn gói".
DIGISTAY_MATBAO_ENV=DEMO
DIGISTAY_MATBAO_TAX_CODE=PASTE_DIGISTAY_MST
DIGISTAY_MATBAO_USERNAME=PASTE_DIGISTAY_MATBAO_USERNAME
DIGISTAY_MATBAO_PASSWORD=PASTE_DIGISTAY_MATBAO_PASSWORD
DIGISTAY_MATBAO_TEMPLATE=1
DIGISTAY_MATBAO_SERIES=PASTE_DIGISTAY_MATBAO_SERIES
# Mã thuế suất Mắt Bão: -1 = không chịu thuế (KCT, mặc định), 0, 5, 8, 10
DIGISTAY_MATBAO_VAT=-1
DIGISTAY_MATBAO_WEBHOOK_SECRET=PASTE_RANDOM_SECRET

# ----- Public site URL -----
NEXT_PUBLIC_SITE_URL=https://digistay.vn

# ----- Email (SMTP — digiso.vn) -----
EMAIL_SERVER_HOST=mail.digiso.vn
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=digistay.noreply@digiso.vn
EMAIL_SERVER_PASSWORD=CHANGE_ME
EMAIL_FROM=Digistay <digistay.noreply@digiso.vn>
# Set false nếu cert SMTP self-signed; true (mặc định) cho prod chuẩn
EMAIL_TLS_REJECT_UNAUTHORIZED=true

# ----- Cloudinary: ảnh tải lên (tài khoản chung với UKNOW; docs/RUNBOOK.md "Lưu ảnh (Cloudinary)") -----
CLOUDINARY_CLOUD_NAME=PASTE_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# ----- Redis (sẽ thêm service vào compose) -----
REDIS_URL=redis://redis:6379

# ----- GHCR -----
GHCR_OWNER=vogiahuy2506-lang
