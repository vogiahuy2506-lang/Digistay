# Scheduled jobs every 10 minutes:
#   - PayOS reconcile (src/lib/payments/payos-reconcile.ts)
#   - e-invoices: auto-issue, uncertain publishes, emails (src/lib/einvoice/jobs.ts)
# Install: docs/RUNBOOK.md, "Đối soát PayOS định kỳ".
# docker/systemd/scheduled-jobs.sh calls them inside the app container
# (CRON_SECRET comes from .env.production); nginx does not route
# /api/internal/. Both jobs run every time; the unit fails if either did.
[Unit]
Description=Digistay scheduled jobs (PayOS reconcile, e-invoices)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /opt/digistay/docker/systemd/scheduled-jobs.sh
