// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?   // Họ và tên đầy đủ
  username      String?   @unique  // Tên đăng nhập
  image         String?
  password      String?
  role          UserRole  @default(USER)
  
  // OAuth providers
  accounts      Account[]
  sessions      Session[]
  
  // User profile
  phone         String?
  address       String?
  dateOfBirth   DateTime?
  avatar        String?
  bio           String?
  
  // Relations
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  invitations      Invitation[]      @relation("InvitationRecipient")
  createdInvitations Invitation[]   @relation("InvitationSender")
  
  // Booking relations
  createdBookings  Booking[]
  notifications    Notification[]

  // Optional two-factor sign-in (src/lib/auth/two-factor.ts)
  twoFactor        UserTwoFactor?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

/// Optional TOTP two-factor sign-in, one row per user (Part 4f). The user
/// turns it on; it is never required. Deleting the row turns it off.
model UserTwoFactor {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// TOTP secret, encrypted with src/lib/security/secret-box.ts
  secret         String
  /// null while setting up: sign-in does not ask for a code until it is confirmed
  enabledAt      DateTime?
  /// sha256 of the unused recovery codes
  recoveryCodes  String[]  @default([])
  /// last TOTP time step accepted, so a code cannot be used twice
  lastUsedStep   Int?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_two_factor")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// WORKSPACE (Không gian làm việc)
// ============================================

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  domain      String?  // Custom domain if any
  
  // Owner of the workspace
  ownerId     String
  owner       User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  
  // Settings
  settings    Json?    @default("{}")
  
  // Relations
  members     WorkspaceMember[]
  properties  Property[]
  invitations Invitation[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("workspaces")
}

model WorkspaceMember {
  id          String          @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole   @default(USER)
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  joinedAt    DateTime  @default(now())
  
  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

enum WorkspaceRole {
  ADMIN      // Chủ sở hữu - Toàn quyền, xóa workspace
  MANAGER    // Quản lý - Quản lý property, members (không xóa được workspace)
  RECEPTIONIST // Lễ tân - Nhân viên lễ tân
  USER       // Người dùng - Tài khoản thường
}

// ============================================
// INVITATION (Mời thành viên)
// ============================================

model Invitation {
  id          String   @id @default(cuid())
  email       String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  role        WorkspaceRole @default(USER)
  token       String   @unique
  
  senderId    String
  sender      User     @relation("InvitationSender", fields: [senderId], references: [id])
  
  recipientId String?
  recipient   User?    @relation("InvitationRecipient", fields: [recipientId], references: [id])
  
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// ============================================
// PROPERTY (Khách sạn / Nhà hàng)
// ============================================

model Property {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  name        String
  slug        String   @unique
  type        PropertyType
  
  // Address
  address     String
  city        String
  district    String?
  ward        String?
  country     String   @default("Vietnam")
  postalCode  String?
  latitude    Float?
  longitude   Float?
  
  // Contact
  phone       String?
  email       String?
  website     String?
  
  // Branding
  logo        String?
  coverImage  String?
  description String?  @db.Text
  /// The hotel's own texts in English: { en: { name?, description?, ... } }. Empty: the Vietnamese shows (src/lib/i18n/content.ts).
  translations Json?
  
  // Subdomain
  subdomain   String   @unique
  isActive    Boolean  @default(true)
  
  // Relations
  roomTypes   RoomType[]
  rooms       Room[]
  amenities   PropertyAmenity[]
  images      PropertyImage[]
  pricing     PricingConfig[]
  bookings    Booking[]
  payments    Payment[]
  invoices    Invoice[]
  websiteBlocks WebsiteBlock[]
  websiteSettings WebsiteSettings?
  bankAccounts   BankAccount[]
  payos          PropertyPayos?
  sepay          PropertySepay?
  einvoice       PropertyEinvoice?
  roomLocks      RoomLock[]
  extraServices   ExtraService[]
  dailyRevenues   DailyRevenue[]
  policy      Policy?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("properties")
}

enum PropertyType {
  HOTEL
  HOMESTAY
  RESORT
  RESTAURANT
  VILLA
  MOTEL
  OTHER
}

// ============================================
// ROOM TYPE (Hạng phòng)
// ============================================

model RoomType {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomLocks   RoomLock[]
  rooms       Room[]

  name        String
  slug        String
  
  // Room details
  description String?  @db.Text
  /// The hotel's own texts in English: { en: { name?, description?, ... } }. Empty: the Vietnamese shows (src/lib/i18n/content.ts).
  translations Json?
  area        Float?   // Diện tích (m2)
  bedType     BedType
  maxAdults   Int      @default(2)
  maxChildren Int      @default(0)
  totalRooms  Int      @default(1)
  availableRooms Int   @default(1)
  
  // Base occupancy
  baseOccupancy Int    @default(2)
  maxOccupancy  Int    @default(4)
  
  // Relations
  images      RoomTypeImage[]
  pricing     RoomTypePricing[]
  amenities   RoomTypeAmenity[]
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, slug])
  @@map("room_types")
}

enum BedType {
  SINGLE
  DOUBLE
  TWIN
  TRIPLE
  QUADRUPLE
  KING
  QUEEN
  SUITE
  BUNK
}

// ============================================
// PRICING (Bảng giá)
// ============================================

model PricingConfig {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  name        String   @default("Standard")
  
  // Base prices
  weekdayPrice    Float   // Giá ngày thường
  weekendPrice    Float   // Giá cuối tuần
  
  // Extra charges
  extraAdultPrice Float   @default(0)  // Phụ thu người lớn thêm
  extraChildPrice Float   @default(0)  // Phụ thu trẻ em thêm
  
  // Hourly pricing (for motels)
  hourlyPrice     Float?
  minHours        Int?
  
  // Active
  isActive    Boolean  @default(true)
  
  // Relations
  roomTypePrices RoomTypePricing[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pricing_configs")
}

model RoomTypePricing {
  id          String   @id @default(cuid())
  roomTypeId  String
  pricingId   String
  
  roomType    RoomType     @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  pricing     PricingConfig @relation(fields: [pricingId], references: [id], onDelete: Cascade)
  
  weekdayPrice    Float
  weekendPrice    Float
  extraAdultPrice Float   @default(0)
  extraChildPrice Float   @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("room_type_pricing")
}

// ============================================
// AMENITIES (Tiện ích)
// ============================================

model Amenity {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  category    String   @default("general")
  
  properties  PropertyAmenity[]
  roomTypes   RoomTypeAmenity[]
  
  createdAt   DateTime @default(now())

  @@map("amenities")
}

model PropertyAmenity {
  id          String   @id @default(cuid())
  propertyId  String
  amenityId   String
  
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity     Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  
  @@unique([propertyId, amenityId])
  @@map("property_amenities")
}

model RoomTypeAmenity {
  id          String   @id @default(cuid())
  roomTypeId  String
  amenityId   String
  
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity     Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  
  @@unique([roomTypeId, amenityId])
  @@map("room_type_amenities")
}

// ============================================
// IMAGES (Hình ảnh)
// ============================================

model PropertyImage {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  url         String
  thumbnail   String?
  alt         String?
  category    String?  // lobby, pool, restaurant, etc.
  
  width       Int?
  height      Int?
  size        Int?
  
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  
  createdAt   DateTime @default(now())

  @@map("property_images")
}

model RoomTypeImage {
  id          String   @id @default(cuid())
  roomTypeId  String
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  
  url         String
  thumbnail   String?
  alt         String?
  
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  
  createdAt   DateTime @default(now())

  @@map("room_type_images")
}

// ============================================
// POLICIES (Chính sách)
// ============================================

model Policy {
  id          String   @id @default(cuid())
  propertyId  String   @unique
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  // Check-in/Check-out
  checkInTime     String  @default("14:00")
  checkOutTime    String  @default("12:00")
  /// Late check-out tiers [{ until: "HH:mm" | null, percent }] (src/lib/bookings/late-checkout.ts);
  /// null = the default (30% until 15:00, 50% until 18:00, then 100%), [] = no late fee.
  lateCheckoutTiers Json?
  
  // Cancellation
  cancellationHours Int?   // Số giờ trước check-in để hủy miễn phí
  cancellationPolicy String? @db.Text
  /// Refund suggested for a cancellation inside that window, in % of what
  /// was paid; 0 = nothing (src/lib/bookings/cancel-refund.ts).
  lateCancelRefundPercent Int @default(0)

  /// Deposit a guest pays through PayOS when booking on the hotel's site,
  /// in % of the total; 0 = none. Needs a connected PayOS account.
  onlineDepositPercent Int @default(0)
  /// Minutes a guest has to pay that deposit before the booking is
  /// cancelled by the scheduled job; 0 = never (the hotel decides).
  depositDeadlineMinutes Int @default(0)
  
  // Children policy
  childrenAllowed Boolean @default(true)
  minChildAge      Int     @default(0)
  
  // Pet policy
  petsAllowed      Boolean @default(false)
  
  // Smoking policy
  smokingAllowed   Boolean @default(false)
  
  // Other rules
  additionalRules  String? @db.Text
  /// The hotel's own texts in English: { en: { name?, description?, ... } }. Empty: the Vietnamese shows (src/lib/i18n/content.ts).
  translations Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("policies")
}

// ============================================
// WEBSITE BUILDER (Block Builder Framework)
// ============================================

model WebsiteBlock {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  type        BlockType
  name        String
  
  // Block content/settings
  config      Json     @default("{}")
  
  // Visibility
  isEnabled   Boolean  @default(true)
  
  // Order
  sortOrder   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("website_blocks")
  @@index([propertyId])
}

enum BlockType {
  HERO              // Banner chính + Search
  ROOMS             // Danh sách phòng
  AMENITIES         // Tiện ích
  ABOUT             // Giới thiệu
  GALLERY           // Thư viện ảnh
  REVIEWS           // Đánh giá khách hàng
  MAP               // Bản đồ
  CONTACT           // Liên hệ
  FOOTER            // Footer
  RESTAURANT_MENU   // Menu nhà hàng
  SERVICES          // Dịch vụ
  CTA               // Call to action
}

model WebsiteSettings {
  id          String   @id @default(cuid())
  propertyId  String   @unique
  
  // Branding
  primaryColor     String  @default("#3B82F6")
  secondaryColor   String  @default("#10B981")
  accentColor      String  @default("#F59E0B")
  /// Buttons, outlines and the CTA band on the site (#rrggbb); null: Digistay's ink.
  buttonColor      String?
  /// Page and section titles on the site (#rrggbb); null: the text color.
  headingColor     String?
  fontFamily       String  @default("Inter")
  headingFont      String  @default("Playfair Display")
  
  // Layout
  layout        String  @default("modern")  // modern, classic, minimal
  containerWidth String @default("1280px")
  
  // SEO
  metaTitle       String?
  metaDescription  String?
  /// The hotel's own texts in English: { en: { name?, description?, ... } }. Empty: the Vietnamese shows (src/lib/i18n/content.ts).
  translations Json?
  metaKeywords    String?
  
  // Custom domain
  customDomain    String?  @unique // lowercase ASCII; set only by /api/website/domain/verify
  domainVerificationStatus String?  // pending, verified, mismatch, not_found, a_record, dns_error
  domainVerifiedAt DateTime?
  
  // SSL
  sslEnabled      Boolean @default(false)
  sslVerifiedAt   DateTime?
  sslProvider     String?  // letsencrypt, cloudflare, digistay-auto-ssl
  sslCertificateId String?
  /// Asked for a certificate (domain verified, or "Thử lại"); docker/certbot/custom-domains.sh picks it up.
  sslRequestedAt  DateTime?
  /// The last issuance attempt, and why it failed (null: issued or not tried yet).
  sslCheckedAt    DateTime?
  sslError        String?
  
  // Published status
  isPublished     Boolean @default(false)
  publishedAt     DateTime?
  
  // Relations
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("website_settings")
}

// ============================================
// BOOKING (Đặt phòng)
// ============================================

model Booking {
  id              String   @id @default(cuid())
  bookingCode     String   @unique
  
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  
  // Guest info
  guestName       String
  guestEmail      String
  guestPhone      String
  guestNote       String?
  
  // Booking details
  checkInDate     DateTime
  checkOutDate    DateTime
  numAdults       Int      @default(1)
  numChildren     Int      @default(0)
  
  // Status
  status          BookingStatus @default(PENDING)
  
  // Pricing
  subtotal        Float    // Tổng tiền phòng
  extraCharges    Float    @default(0)  // Phụ phí
  /// The extra services chosen when booking, as charged (in extraCharges):
  /// [{ serviceId, name, quantity, amount }] (src/lib/pricing/quote.ts)
  services        Json?
  discount        Float    @default(0)  // Giảm giá
  totalAmount     Float    // Tổng cộng
  depositAmount   Float    @default(0)  // Tiền cọc đã thanh toán
  
  // Payment
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus @default(PENDING)
  paymentDueDate  DateTime?
  
  // VAT Invoice
  vatCompany      String?
  vatTaxCode      String?
  vatAddress      String?
  vatEmail        String?
  
  // Check-in/out
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  checkedInBy     String?
  checkedOutBy    String?
  
  // Source
  source          BookingSource @default(DIRECT)
  referralCode    String?
  
  // Staff who created (for walk-in)
  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id])

  /// The guest's language, 'vi' | 'en': the page they booked on (staff bookings: 'vi').
  /// Their emails follow it (src/lib/email/i18n.ts).
  locale          String   @default("vi")
  
  // Relations
  bookingItems    BookingItem[]
  roomLocks       RoomLock[]
  payments        Payment[]
  invoices        Invoice[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("bookings")
  @@index([propertyId])
  @@index([bookingCode])
  @@index([status])
  @@index([checkInDate])
}

enum BookingStatus {
  PENDING           // Chờ thanh toán
  CONFIRMED         // Đã xác nhận
  CHECKED_IN        // Đã nhận phòng
  CHECKED_OUT       // Đã trả phòng
  CANCELLED         // Đã hủy
  NO_SHOW           // Không đến
}

enum BookingSource {
  DIRECT            // Đặt trực tiếp trên web
  WALK_IN           // Đặng tại quầy
  PHONE             // Đặt qua điện thoại
  OTA               // OTA (Traveloka, Booking.com...)
  AGENT             // Đại lý
}

model BookingItem {
  id              String   @id @default(cuid())
  bookingId       String
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  roomTypeId     String
  
  // Room number (assigned later); roomId once the hotel lists its rooms
  // (src/lib/bookings/rooms.ts), the number then copied from the room
  roomNumber     String?
  roomId         String?
  room           Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  
  // Dates
  checkInDate    DateTime
  checkOutDate   DateTime
  
  // Pricing for this item
  basePrice      Float
  extraAdultPrice Float   @default(0)
  extraChildPrice Float   @default(0)
  totalPrice     Float
  
  // Extra services
  extraServices  Json?    @default("[]")
  
  createdAt      DateTime @default(now())

  @@map("booking_items")
  @@index([bookingId])
}

/// One numbered room of the hotel (task 25 / 27, src/lib/bookings/rooms.ts).
/// Once a room type has rooms, its totalRooms is the number of active ones.
model Room {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId  String
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  /// "101", "A12": unique in the hotel
  number      String
  floor       Int?
  isActive    Boolean  @default(true)
  bookingItems BookingItem[]
  roomLocks   RoomLock[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, number])
  @@index([roomTypeId])
  @@map("rooms")
}

model RoomLock {
  id              String   @id @default(cuid())
  bookingId       String?
  booking         Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomTypeId      String
  roomType        RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  /// one room under maintenance (rooms.ts); null: any room of the type
  roomId          String?
  room            Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  // Lock period
  lockStart       DateTime
  lockEnd         DateTime
  
  // Lock type
  type            RoomLockType @default(HOLD)
  
  // Who/what locked
  sessionId       String?
  customerInfo    String?
  
  expiresAt       DateTime?  // Lock expires at this time (null for maintenance locks)
  notes           String?

  createdAt       DateTime @default(now())

  @@map("room_locks")
  @@index([propertyId])
  @@index([roomTypeId])
  @@index([lockStart, lockEnd])
}

enum RoomLockType {
  HOLD             // Giữ tạm thời (khi đặt)
  BOOKED           // Đã đặt thành công
  MAINTENANCE     // Bảo trì
  BLOCKED          // Chặn thủ công
}

// ============================================
// EXTRA SERVICES (Dịch vụ kèm theo)
// ============================================

model ExtraService {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  /// The hotel's own texts in English: { en: { name?, description?, ... } }. Empty: the Vietnamese shows (src/lib/i18n/content.ts).
  translations Json?
  /// laundry | transport | food | entertainment | other (the services page's groups)
  category    String?
  
  // Pricing
  priceType   PriceType @default(FIXED)
  price       Float
  
  // Per person/per room
  perPerson   Boolean @default(false)
  
  isActive    Boolean @default(true)
  
  createdAt   DateTime @default(now())

  @@map("extra_services")
  @@index([propertyId])
}

// ============================================
// PAYMENT (Thanh toán)
// ============================================

model Payment {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  // Property reference
  property        Property @relation(fields: [propertyId], references: [id])
  propertyId       String
  
  // Amount
  amount          Float
  fee             Float    @default(0)
  netAmount       Float
  
  // Method
  method          PaymentMethod
  
  // Status
  status          PaymentStatus @default(PENDING)
  
  // Bank transfer
  bankCode        String?
  bankAccount     String?
  accountHolder   String?
  transferContent String?
  
  // QR Code
  qrCodeUrl       String?
  qrExpiresAt     DateTime?
  
  // Transaction reference
  transactionId   String?   // Từ cổng thanh toán
  paymentGateway  PaymentGateway?
  /// PayOS orderCode (16 digits, kept as text so payments stay JSON-safe),
  /// unique across all properties (src/lib/payments/payos.ts)
  gatewayOrderCode String?  @unique
  /// PayOS checkout page for the guest
  checkoutUrl     String?
  
  // Timestamps
  paidAt          DateTime?
  expiresAt       DateTime?
  
  // Metadata
  metadata        Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("payments")
  @@index([bookingId])
  @@index([status])
}

enum PaymentMethod {
  BANK_TRANSFER    // Chuyển khoản
  QR_VIETQR       // VietQR
  CARD            // Thẻ ATM
  CREDIT_CARD     // Thẻ tín dụng
  E_WALLET        // Ví điện tử
  CASH            // Tiền mặt
}

enum PaymentStatus {
  PENDING         // Chờ thanh toán
  PROCESSING      // Đang xử lý
  PAID            // Đã thanh toán
  PARTIAL         // Thanh toán một phần
  FAILED          // Thất bại
  REFUNDED        // Đã hoàn tiền
  CANCELLED       // Đã hủy
  EXPIRED         // Hết hạn
}

enum PaymentGateway {
  VIETQR
  PAYOS
  VNPAY
  ONEPAY
  STRIPE
  MOMO
  ZALOPAY
  SEPAY
}

enum PriceType {
  FIXED           // Giá cố định
  PER_NIGHT       // Theo đêm
  PER_PERSON      // Theo người
}

// ============================================
// BANK ACCOUNT (Tài khoản ngân hàng)
// ============================================

model BankAccount {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  bankName        String
  bankCode        String   // VietQR bank code
  accountNumber   String
  accountHolder   String
  
  // QR settings
  qrEnabled       Boolean @default(true)
  
  // Status
  isActive        Boolean @default(true)
  isVerified      Boolean @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("bank_accounts")
  @@index([propertyId])
}

/// The property's own PayOS account (Part 5): guests pay straight into the
/// hotel's bank account and PayOS confirms the payment by webhook. Keys
/// are encrypted with src/lib/security/secret-box.ts.
model PropertyPayos {
  propertyId         String    @id
  property           Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  clientId           String
  /// encrypted
  apiKey             String
  /// encrypted
  checksumKey        String
  /// set once PayOS accepted our webhook URL; payments need it
  webhookConfirmedAt DateTime?
  /// the bank account PayOS pays into, as PayOS reports it
  accountName        String?
  accountNumber      String?
  connectedById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("property_payos")
}

/// The property's own SePay payment gateway account, for card payments
/// (src/lib/payments/sepay.ts): guests pay by Visa / Mastercard / JCB into
/// the hotel's SePay merchant. The secret key is encrypted with secret-box.
model PropertySepay {
  propertyId    String    @id
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  merchantId    String
  /// encrypted
  secretKey     String
  /// sandbox | production
  environment   String    @default("sandbox")
  /// set once SePay accepted the keys; card payments need it
  verifiedAt    DateTime?
  connectedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("property_sepay")
}

/// The property's own Mắt Bão e-invoice account (Part 6): invoices are issued
/// under the hotel's tax code. The password is encrypted with
/// src/lib/security/secret-box.ts.
model PropertyEinvoice {
  propertyId       String    @id
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// DEMO (demo-api-hddt.matbao.in) or PRODUCTION: invoices issued in
  /// production are legal documents
  environment      String
  /// Mã số thuế of the hotel (seller), as Mắt Bão knows it
  taxCode          String
  username         String
  /// encrypted
  password         String
  /// KHMSHDon, e.g. "1"
  templateCode     String
  /// KHHDon, e.g. "C26TAA" (changes every calendar year)
  series           String
  /// Mắt Bão TSuat: 10, 8, 5, 0, -1 (KCT), -2 (KKKNT); set by the hotel's accountant
  vatCode          Int
  /// set when login and the series check last succeeded
  verifiedAt       DateTime?
  /// numbers left in the series at the last check (CLai)
  remainingNumbers Int?
  /// encrypted; part of the webhook URL given to Mắt Bão support
  webhookToken     String?
  /// Issue an invoice by itself once a booking is fully paid (jobs.ts).
  /// Off by default: the hotel's accountant decides
  autoIssue        Boolean   @default(false)
  /// when autoIssue was last turned on: bookings paid before are left alone
  autoIssueSince   DateTime?
  /// email each issued invoice (PDF attached) to the buyer (delivery.ts)
  emailInvoices    Boolean   @default(true)
  connectedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("property_einvoice")
}

// ============================================
// INVOICE (Hóa đơn điện tử)
// ============================================

model Invoice {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id])
  
  // Property reference
  property        Property @relation(fields: [propertyId], references: [id])
  propertyId      String
  
  invoiceNumber   String   @unique
  invoiceCode     String?  // Mã hóa đơn từ cổng
  
  // Company info
  companyName     String
  companyAddress  String
  taxCode         String
  companyEmail    String?
  
  // Customer
  customerName    String
  customerEmail   String
  customerAddress String?
  
  /// company | personal | consumer (khách lẻ không lấy hoá đơn)
  buyerType       String   @default("company")

  // Totals: totalAmount is what the guest pays (VAT included); subtotal
  // and taxAmount are split from it (src/lib/einvoice/vat.ts)
  subtotal        Float
  taxRate         Float    @default(0.1)
  /// Mắt Bão TSuat at creation (10, 8, 5, 0, -1 KCT, -2 KKKNT)
  vatCode         Int?
  taxAmount       Float
  totalAmount     Float
  
  // Status
  status          InvoiceStatus @default(DRAFT)
  
  // Electronic invoice
  invoicePattern  String?  // 01GTKT
  invoiceSeries   String?  // NC
  fiscalCode      String?  // Mã số thuế
  
  // E-invoice provider
  eInvoiceProvider EInvoiceProvider?
  
  // Published info
  publishedAt     DateTime?
  xmlUrl          String?
  pdfUrl          String?
  /// Mắt Bão MaTraCuu: fixed per invoice, so publishing again never
  /// issues a second one (src/lib/einvoice/matbao.ts)
  lookupCode      String?  @unique
  /// Số hoá đơn assigned by Mắt Bão
  einvoiceNumber  String?
  /// Why the last publish attempt failed (shown to staff)
  publishError    String?
  /// Tax office status from Mắt Bão's webhook (MaTTHDon: 4 code issued,
  /// 6 refused...), its note and the tax office code (MCCQT)
  cqtStatus       Int?
  cqtNote         String?
  cqtCode         String?

  /// Replacement invoice (TCHDon 1): the issued invoice this one replaces;
  /// that one becomes REPLACED once this is issued
  replacesInvoiceId String?
  replacesInvoice   Invoice?  @relation("InvoiceReplacement", fields: [replacesInvoiceId], references: [id])
  replacements      Invoice[] @relation("InvoiceReplacement")

  /// Adjustment invoice (TCHDon 2 increase, 3 decrease): the issued invoice
  /// it adjusts. totalAmount is the signed difference, negative for a
  /// decrease; the adjusted invoice stays PUBLISHED (adjustment.ts)
  adjustsInvoiceId  String?
  adjustsInvoice    Invoice?  @relation("InvoiceAdjustment", fields: [adjustsInvoiceId], references: [id])
  adjustments       Invoice[] @relation("InvoiceAdjustment")

  /// created by the auto-issue job (jobs.ts), not by staff
  autoIssued      Boolean   @default(false)
  /// Email to the buyer once issued (delivery.ts): PENDING, SENDING, SENT,
  /// FAILED (tried again at emailNextAt while it is set), SKIPPED
  emailStatus     String?
  emailAttempts   Int       @default(0)
  /// next attempt; while SENDING, when the claim expires
  emailNextAt     DateTime?
  emailedAt       DateTime?
  emailError      String?
  
  // Metadata
  metadata        Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("invoices")
  @@index([bookingId])
  @@index([invoiceNumber])
}

enum InvoiceStatus {
  DRAFT           // Nháp
  PENDING         // Chờ phát hành
  PUBLISHING      // Đang gửi sang nhà cung cấp
  PUBLISHED       // Đã phát hành
  CANCELLED       // Đã hủy
  REPLACED        // Thay thế
}

enum EInvoiceProvider {
  MATBAO
  MISA
  VNPT
  VIETTAX
  FAST
  BASE
}

// ============================================
// REVENUE REPORT (Báo cáo doanh thu)
// ============================================

model DailyRevenue {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  date        DateTime @db.Date
  
  // Room revenue
  roomRevenue     Float @default(0)
  extraRevenue    Float @default(0)
  totalRevenue   Float @default(0)
  
  // Bookings
  totalBookings      Int @default(0)
  confirmedBookings   Int @default(0)
  checkedInBookings  Int @default(0)
  checkedOutBookings Int @default(0)
  cancelledBookings  Int @default(0)
  
  // Room stats
  totalRooms      Int @default(0)
  occupiedRooms   Int @default(0)
  avgOccupancy    Float @default(0)
  
  // Payment breakdown
  cashRevenue     Float @default(0)
  bankRevenue     Float @default(0)
  qrRevenue       Float @default(0)
  cardRevenue     Float @default(0)
  
  createdAt       DateTime @default(now())

  @@unique([propertyId, date])
  @@map("daily_revenues")
  @@index([propertyId])
}

// ============================================
// ACTIVITY LOG
// ============================================

model ActivityLog {
  id          String   @id @default(cuid())
  
  userId      String?
  workspaceId String?
  propertyId  String?
  
  action      String
  entityType  String
  entityId    String
  changes     Json?
  metadata    Json?
  
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())

  @@map("activity_logs")
  @@index([workspaceId])
  @@index([propertyId])
  @@index([userId])
}

/// One run of a scheduled job (src/lib/ops/job-runs.ts): the jobs under
/// /api/internal/ and docker/backup.sh (which writes its row with psql).
/// Kept 30 days.
model JobRun {
  id         String    @id @default(cuid())
  /// payos-reconcile, einvoice-jobs, ops-alerts, backup
  job        String
  /// RUNNING, SUCCESS, FAILURE
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    Json?
  error      String?

  @@index([job, startedAt])
  @@map("job_runs")
}

/// What the ops alert job last saw for one rule (src/lib/ops/alerts.ts),
/// so the same problem is emailed once and then only as a reminder.
model AlertState {
  key         String    @id
  /// critical or warning
  severity    String
  /// the items the alert was about; a new item means a new email
  fingerprint String
  title       String
  firstSeenAt DateTime  @default(now())
  lastSentAt  DateTime?
  resolvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("alert_states")
}

/// The bell in the dashboard (src/lib/notifications.ts): one row per
/// recipient. The words are rendered in the reader's language from `type`
/// and `data`; `link` is the page it opens.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  propertyId  String?
  /// booking_new | deposit_paid
  type        String
  data        Json
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Emails sent after the request (src/lib/email/outbox.ts): kept until
/// sent, retried with backoff, alerted when given up. The rendered message
/// is encrypted (an invitation carries its token). Sent ones are dropped
/// after 30 days.
model EmailOutbox {
  id        String    @id
  /// booking_confirmation, owner_new_booking, workspace_invite, deposit_received, deposit_expired, contact_request
  kind      String
  toEmail   String
  /// encrypted JSON { to, name, subject, text, html }
  message   String
  /// PENDING, SENDING, SENT, FAILED
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  /// next attempt; while SENDING, when the claim expires
  nextAt    DateTime?
  sentAt    DateTime?
  error     String?
  /// what it is about (booking or invitation id)
  refId     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, nextAt])
  @@map("email_outbox")
}
