# ============================================================
# DATABASE - PostgreSQL (Neon / Supabase / local all work)
# ============================================================
# Pooled URL (used by the app at runtime). For Neon serverless /
# PgBouncer in front of Postgres, append ?pgbouncer=true&connect_timeout=10
# so the Prisma client knows to expect short-lived connections.
DATABASE_URL="postgresql://user:password@localhost:5432/digistay?schema=public"

# Direct (unpooled) connection — recommended for Prisma migrations
# and any code path that runs long-lived queries.
# DIRECT_URL="postgresql://user:password@localhost:5432/digistay?schema=public"

# ============================================================
# CACHE (optional in dev)
# ============================================================
# Without this, the app falls back to an in-memory stub. Set it
# when you want shared cache across restarts / instances.
# REDIS_URL="redis://localhost:6379"

# ============================================================
# NEXTAUTH (NextAuth.js v4)
# ============================================================
NEXTAUTH_URL="http://localhost:3000"
# Generate one with: openssl rand -hex 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string-at-least-16-chars"

# ============================================================
# DATA ENCRYPTION (src/lib/security/secret-box.ts)
# ============================================================
# Encrypts secrets stored in the DB (2FA secrets, hotel payment keys...).
# Required: /api/health fails without it. Format: <keyId>:<base64 32 bytes>,
# comma-separated, newest first. Generate: echo "1:$(openssl rand -base64 32)"
DATA_ENCRYPTION_KEYS=

# Secret of the scheduled jobs (/api/internal/*, docker/systemd timers).
# Generate: openssl rand -hex 32
# CRON_SECRET=
# Ops alert emails (src/lib/ops/alerts.ts), comma separated; default: SUPER_ADMIN users.
# ALERT_EMAILS=ops@example.com
# Requests from the /contact form; without it they go to ALERT_EMAILS.
# CONTACT_EMAILS=sales@example.com

# ============================================================
# OAUTH PROVIDERS
# ============================================================
# Get credentials: https://console.cloud.google.com/apis/credentials
# 1. Create project → Enable "Google Identity" or just go to Credentials
# 2. Configure OAuth consent screen (External, add your domain)
# 3. Create OAuth Client ID → Application type: Web application
# 4. Authorized JavaScript origins:
#      http://localhost:3000
#      https://yourdomain.com
# 5. Authorized redirect URIs:
#      http://localhost:3000/api/auth/callback/google
#      https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================================
# EMAIL (optional — without RESEND_API_KEY, the mailer logs to
# the console and reports sent=false to the caller)
# ============================================================
# Get a key at https://resend.com/api-keys
# RESEND_API_KEY=""
# EMAIL_FROM="Digistay <noreply@digistay.vn>"

# Public site URL — used in email links, booking confirmation, etc.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================================
# IMAGE STORAGE (optional — both providers are no-ops without keys)
# ============================================================
# Cloudinary — photo uploads (src/lib/cloudinary). Without the three, uploads
# answer 503 ("Chưa cấu hình nơi lưu ảnh"); photos added by link still work.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# AWS S3 (alternative)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_S3_BUCKET=""

# ============================================================
# LEGACY SMTP FIELDS (kept for older .env files; not currently
# used — Digistay sends email through Resend)
# ============================================================
# EMAIL_SERVER_HOST="smtp.gmail.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER="your-email@gmail.com"
# EMAIL_SERVER_PASSWORD="your-app-password"
