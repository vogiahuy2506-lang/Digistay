# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage
/vitest-report.json

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem
*.key
*.p12
# Google Cloud service-account key files
*-service-account*.json
gen-lang-client-*.json

# Scratch scripts for preparing brand artwork
/.tmp-logos/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files: only templates holding placeholders may be committed (a real
# .env.production.template was committed on 2026-10-19 and had to be
# rotated). gitleaks also scans every PR and push to main.
.env
.env.*
!.env.example
!.env.*.example
!.env.production.template

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma
/prisma/*.db
/prisma/*.db-journal

# Uploads
/uploads

# Rendered from app-secure.conf.template by docker/deploy.sh (and init-cert.sh)
/docker/nginx/conf.d/app-secure.conf
/docker/nginx/conf.d/*.bak

# Browser tests (Playwright): run state and reports
/e2e/.state/
/playwright-report/
/test-results/

# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
# The **/ prefix covers .impeccable at the repo root or in a nested workspace.
# Shared artifacts stay tracked: config.json, live/config.json,
# design.json, surfaces/*.md, critique/*.md.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png
# impeccable-ignore-end
